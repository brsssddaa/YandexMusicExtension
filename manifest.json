{
  "manifest_version": 3,
  "name": "Яндекс Музыка (Plus Unlock & AdBlock)",
  "version": "1.0.2",
  "description": "Слушайте треки в высоком качестве (320 kbps), без рекламы и ограничений на переключение треков на ПК и смартфонах.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.music.yandex.ru/*",
    "*://music.yandex.ru/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.music.yandex.ru/*",
        "*://music.yandex.ru/*"
      ],
      "js": [
        "page_inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.music.yandex.ru/*",
        "*://music.yandex.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_inject.js",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "*://*.music.yandex.ru/*",
        "*://music.yandex.ru/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Яндекс Музыка (Plus Unlock)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
